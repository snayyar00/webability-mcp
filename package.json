{
  "name": "@webability/mcp",
  "mcpName": "io.github.snayyar00/webability",
  "version": "1.3.1",
  "description": "WebAbility MCP server \u2014 WCAG 2.2 / ADA / EAA accessibility scanning with three-tier confidence output (issues + incomplete + summary), framework-aware AI fix suggestions, and brand-palette contrast checks. For Cursor, Claude Code, and other IDEs.",
  "type": "module",
  "bin": {
    "abilyo-mcp": "./dist/index.js",
    "webability-mcp": "./dist/index.js",
    "webability-mcp-http": "./dist/http.js"
  },
  "scripts": {
    "build": "tsup src/index.ts src/http.ts --format esm --dts --minify --clean",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http.ts",
    "start:http": "node dist/http.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "a11y",
    "abilyo",
    "accessibility",
    "ada",
    "axe",
    "axe-core",
    "claude",
    "copilot",
    "cursor",
    "eaa",
    "mcp",
    "scanner",
    "section-508",
    "wcag",
    "webability"
  ],
  "author": "WebAbility <support@webability.io>",
  "license": "MIT",
  "dependencies": {
    "@webability/core": "^1.2.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "axe-core": "^4.11.3",
    "playwright": "1.59.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://webability.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/snayyar00/webability-mcp"
  }
}
