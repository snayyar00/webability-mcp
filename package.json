{
  "name": "@webability/mcp",
  "mcpName": "io.github.snayyar00/webability",
  "version": "1.6.4",
  "description": "WebAbility MCP server — WCAG 2.2 / ADA / EAA accessibility scanning with three-tier confidence output (issues + incomplete + summary), framework-aware AI fix suggestions, and brand-palette contrast checks. For Cursor, Claude Code, and other IDEs.",
  "type": "module",
  "bin": {
    "mcp": "./dist/index.js",
    "abilyo-mcp": "./dist/index.js",
    "webability-mcp": "./dist/index.js",
    "webability-mcp-http": "./dist/http.js",
    "webability-tunnel": "./dist/tunnel-cli.js"
  },
  "scripts": {
    "prepublishOnly": "node ../scripts/require-pnpm-publish.mjs",
    "build": "tsup src/index.ts src/http.ts src/tunnel-cli.ts --format esm --dts --minify --clean",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http.ts",
    "start:http": "node dist/http.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "tsx --test test/*.test.ts"
  },
  "keywords": [
    "a11y",
    "accessibility",
    "ada",
    "axe",
    "axe-core",
    "claude",
    "copilot",
    "cursor",
    "eaa",
    "mcp",
    "scanner",
    "section-508",
    "wcag",
    "webability"
  ],
  "author": "WebAbility <support@webability.io>",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@posthog/mcp": "0.17.0",
    "@webability/core": "1.4.0",
    "axe-core": "^4.11.3",
    "jsdom": "^29.0.2",
    "playwright": "1.59.1",
    "posthog-node": "^5.46.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/jsdom": "^27.0.0",
    "@types/node": "^25.6.0",
    "@types/ws": "^8.5.12",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": "^20.20.0 || >=22.22.0"
  },
  "homepage": "https://webability.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/snayyar00/webability-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/snayyar00/webability-mcp/issues"
  }
}
